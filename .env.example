# Comma-separated X usernames. Leave empty to run the web service without syncing.
ARCHIVE_ACCOUNTS=

# twscrape account/session SQLite file, or a directory containing accounts.db.
TWSCRAPE_SESSION_PATH=/data/twscrape

# Persistent archive storage.
ARCHIVE_DB_PATH=/data/archive.sqlite3
ARCHIVE_DATA_DIR=/data/archive

# Synchronization settings, used by the crawler in a later step.
ARCHIVE_INITIAL_LOOKBACK_DAYS=30
ARCHIVE_SYNC_INTERVAL_SECONDS=21600
ARCHIVE_TIMEZONE=Asia/Shanghai

# Media settings, used by the media downloader in a later step.
ARCHIVE_MEDIA_ENABLED=true
ARCHIVE_MEDIA_MAX_BYTES=0

# Web service.
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_AUTH_TOKEN=change-me-before-production
LOG_LEVEL=INFO
