# Comma-separated X usernames. Leave empty to run the web service without syncing.
ARCHIVE_ACCOUNTS=

# twscrape account/session SQLite file, or a directory containing accounts.db.
TWSCRAPE_SESSION_PATH=/data/twscrape

# Persistent archive storage.
ARCHIVE_DB_PATH=/data/archive.sqlite3
ARCHIVE_DATA_DIR=/data/archive

# Synchronization settings.
# Maximum posts imported per account on its first sync. Use -1 for no limit.
ARCHIVE_INITIAL_POST_LIMIT=-1
# Stop an incremental scan after this many consecutive known posts. Use -1 for no limit.
ARCHIVE_INCREMENTAL_KNOWN_POST_LIMIT=20
ARCHIVE_SYNC_INTERVAL_SECONDS=21600
ARCHIVE_TIMEZONE=Asia/Shanghai

# Media downloader settings. Set false to retain metadata without downloading files.
ARCHIVE_MEDIA_ENABLED=true
ARCHIVE_MEDIA_MAX_BYTES=0

# Web service.
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_AUTH_TOKEN=change-me-before-production
# Identity shown for the current token-authenticated web session.
WEB_AUTH_DISPLAY_NAME=ArchiveX 管理员
WEB_AUTH_USERNAME=admin
WEB_AUTH_AVATAR_URL=
# Use a distinct random value of at least 32 characters in production.
WEB_SESSION_SECRET=
# Set true behind HTTPS. Keep false for local HTTP development.
WEB_COOKIE_SECURE=false
LOG_LEVEL=INFO
